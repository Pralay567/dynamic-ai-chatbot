# Copy this file to ".env" (same folder as run.py) and fill in your values.
#   Windows (Command Prompt):  copy .env.example .env
#   Windows (PowerShell):      Copy-Item .env.example .env
#
# NEVER commit ".env", paste it into chats, or share it. It is listed in .gitignore.
# Real environment variables override values in this file.

# ---------------------------------------------------------------------------
# AI provider selection
# ---------------------------------------------------------------------------
# Choose: openrouter or gemini
AI_PROVIDER=openrouter

# ---------------------------------------------------------------------------
# OpenRouter (recommended for the current project setup)
# ---------------------------------------------------------------------------
# Create a key at https://openrouter.ai/keys.
# Keep your real key only in your local .env file.
OPENROUTER_API_KEY=

# Model identifier. The free router can select an available free model.
# See https://openrouter.ai/models for available models and identifiers.
OPENROUTER_MODEL=openrouter/free

# ---------------------------------------------------------------------------
# Gemini (optional alternative provider)
# ---------------------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey.
# Do not reuse any key that was ever stored in project files or shared.
GEMINI_API_KEY=

# Exact API model code name, e.g. a "...-flash" model. There is deliberately no
# default: model names are retired over time. Look up a currently supported name at
#   https://ai.google.dev/gemini-api/docs/models
#   https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=

# Seconds to wait for Gemini before giving up (1-120).
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1000
DEFAULT_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Conversation storage and memory
# ---------------------------------------------------------------------------
# SQLite file holding conversations, messages and feedback. Relative paths are inside
# the project folder. It contains the text of every stored chat: keep it private and
# never commit it (it is git-ignored). Delete the file to erase all stored chats.
DATABASE_PATH=data/chatbot.db

# How much earlier conversation the AI sees with each new message: the most recent
# completed messages that fit BOTH limits (0 messages = the AI never sees earlier ones).
HISTORY_MAX_MESSAGES=20
HISTORY_MAX_CHARS=12000

# A single conversation can hold at most this many stored messages (user + assistant).
MAX_CONVERSATION_MESSAGES=400

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000

# Flask debug mode. Only allowed together with HOST=127.0.0.1. Leave false for demos.
APP_DEBUG=false

# ---------------------------------------------------------------------------
# Limits and protection
# ---------------------------------------------------------------------------
MAX_MESSAGE_CHARS=1000
# Requests per minute per client IP for the chat endpoints. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=20
# Requests per minute per client IP for loading/deleting conversations. 0 disables.
API_RATE_LIMIT_PER_MINUTE=120

# Comma-separated list of OTHER websites allowed to call the API from a browser,
# e.g. https://myapp.example.com. Empty (default) = same-origin only, which is all
# the built-in web interface needs. "*" is intentionally not accepted.
CORS_ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app (0 when running directly).
TRUSTED_PROXY_COUNT=0

# ---------------------------------------------------------------------------
# Logging (message text and IP addresses are never logged)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Relative paths are inside the project folder. Leave empty to log to the console only.
LOG_FILE=logs/chatbot.log